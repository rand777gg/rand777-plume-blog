{
  "name": "rand777-blog-plume",
  "type": "module",
  "description": "rand777's blog.",
  "packageManager": "pnpm@10.30.3",
  "author": "rand777",
  "scripts": {
    "docs:dev": "vuepress dev docs",
    "docs:dev-clean": "vuepress dev docs --clean-cache --clean-temp",
    "docs:build": "vuepress build docs --clean-cache --clean-temp",
    "lint": "pnpm lint:eslint && pnpm lint:css && pnpm lint:md",
    "lint:fix": "pnpm lint:eslint --fix && pnpm lint:css --fix",
    "lint:eslint": "eslint docs/.vuepress/",
    "lint:css": "stylelint \"docs/.vuepress/**/*.{css,vue}\"",
    "lint:md": "markdownlint-cli2 \"docs/**/*.md\" \"*.md\" \"#node_modules\"",
    "docs:preview": "http-server docs/.vuepress/dist",
    "vp-update": "pnpm dlx vp-update",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@pengzhanbo/eslint-config-vue": "^2.6.1",
    "@pengzhanbo/stylelint-config": "^2.6.1",
    "@vuepress/bundler-vite": "2.0.0-rc.30",
    "@vuepress/plugin-llms": "2.0.0-rc.130",
    "eslint": "^10.4.1",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.22.1",
    "markmap-lib": "^0.18.12",
    "markmap-toolbar": "^0.18.12",
    "markmap-view": "^0.18.12",
    "postcss-html": "^1.8.1",
    "sass-embedded": "^1.99.0",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tsconfig-vuepress": "^7.0.0",
    "vue": "^3.5.34",
    "vuepress": "2.0.0-rc.30",
    "vuepress-theme-plume": "1.0.0-rc.203"
  },
  "dependencies": {
    "@iconify/json": "^2.2.473",
    "@vuepress/shiki-twoslash": "2.0.0-rc.130",
    "clsx": "^2.1.1",
    "cobe": "^0.6.5",
    "dotted-map": "^2.2.3",
    "echarts": "^5.6.0",
    "echarts-gl": "^2.0.9",
    "esbuild": "^0.27.7",
    "mermaid": "^11.15.0",
    "motion": "12.38.0",
    "motion-v": "^1.10.3",
    "postprocessing": "^6.39.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "typescript": "^5.9.3",
    "vue-use-spring": "^0.3.3"
  },
  "pnpm": {
    "overrides": {
      "framer-motion": "12.38.0",
      "motion-dom": "12.38.0",
      "motion-utils": "12.36.0",
      "@types/node": "25.8.0",
      "@vue/language-core": "3.2.9",
      "baseline-browser-mapping": "2.10.30",
      "dompurify": "3.4.4",
      "lru-cache": "11.3.6"
    }
  }
}
